{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "highlight.js/lib/core": ["../../packages/server/types/highlight.d.ts"], "highlight.js/lib/languages/*": ["../../packages/server/types/highlight-language.d.ts"] }
  },
  "include": ["src", "test"]
}
