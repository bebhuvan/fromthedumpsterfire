{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The Desk: its UI (static assets built from apps/desk) and its API, plus the one public route
  // the reader app needs (POST /v1/devices). Every request reaches the Worker first so that the
  // in-Worker Access check guards the UI as well as the API; Cloudflare Access at the edge is the
  // outer lock. No bindings at the top level: every deploy must name an environment.
  "name": "fdf-desk",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../../apps/desk/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "env": {
    "preview": {
      "name": "fdf-desk-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "SPEND_WARN_USD": "8",
        "SPEND_CEILING_USD": "10",
        "FILES_BASE": "https://fdf-desk-preview.r-bhuvanesh2007.workers.dev/files",
        "SITE_BASE": "https://fromthedumpsterfire.com",
        "CF_ACCOUNT_ID": "169758eb3d46dcbb6dba025317257426",
        "AI_GATEWAY_ID": "fdf-preview",
        // Access: the team domain and the application's AUD tag, from the Zero Trust dashboard.
        // Empty values deny every Desk request (fail closed).
        "ACCESS_TEAM_DOMAIN": "nameless-cell-b28f.cloudflareaccess.com",
        "ACCESS_AUD": "7563cb7bfd315acef12832457cb54f0294d9cb9d2612d4198a91066b78ddef4f",
        "OWNER_EMAIL": "owner@example.com",
        // Exact Access service Client IDs; empty keeps machine access off. See docs/EDITORIAL.md.
        "ACCESS_SERVICE_CLIENT_IDS": "3e90eab300e2381903d974809c091fcc.access",
        "ACCESS_SERVICE_PUBLISH_CLIENT_IDS": ""
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "fdf-desk-preview", "database_id": "8da223f8-d555-450b-8e44-62bbae0015e7", "migrations_dir": "../../migrations" }
      ],
      // MEDIA is private Desk material; FILES holds only what publish writes: Hauls (hauls/) and the shelf (shelf/).
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "fdf-files-preview" },
        { "binding": "FILES", "bucket_name": "fdf-public-preview" }
      ],
      "ai": { "binding": "AI" },
      "queues": { "producers": [{ "binding": "INGEST_QUEUE", "queue": "fdf-ingest-preview" }] },
      // POST /v1/devices is public; 20 registrations per IP per minute is ample for the app.
      "ratelimits": [{ "name": "DEVICE_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } }],
      "workers_dev": true,
      "preview_urls": false
    },
    "production": {
      "name": "fdf-desk",
      "vars": {
        "ENVIRONMENT": "production",
        "SPEND_WARN_USD": "8",
        "SPEND_CEILING_USD": "10",
        "FILES_BASE": "https://files.fromthedumpsterfire.com",
        "SITE_BASE": "https://fromthedumpsterfire.com",
        "CF_ACCOUNT_ID": "169758eb3d46dcbb6dba025317257426",
        "AI_GATEWAY_ID": "fdf",
        "ACCESS_TEAM_DOMAIN": "nameless-cell-b28f.cloudflareaccess.com",
        "ACCESS_AUD": "fb6c6d7db7c68cb8be14e68af742081fe5ee0582d8c2eafc622ce36d735519c5",
        "OWNER_EMAIL": "owner@example.com",
        // Exact Access service Client IDs; empty keeps machine access off. See docs/EDITORIAL.md.
        "ACCESS_SERVICE_CLIENT_IDS": "9346d4d5af5f18122365892814b58aa0.access,79001c9b73ca2b771db68d94ec18969b.access",
        "ACCESS_SERVICE_PUBLISH_CLIENT_IDS": ""
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "fdf-desk", "database_id": "73a6d440-5bc9-4583-9a67-e8be10f23c7a", "migrations_dir": "../../migrations" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "fdf-media" },
        { "binding": "FILES", "bucket_name": "fdf-files" }
      ],
      "ai": { "binding": "AI" },
      "queues": { "producers": [{ "binding": "INGEST_QUEUE", "queue": "fdf-ingest" }] },
      "ratelimits": [{ "name": "DEVICE_LIMITER", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }],
      // desk.fromthedumpsterfire.com sits behind the "FDF Desk" Access application (owner only);
      // api.fromthedumpsterfire.com is public at the edge, and the Worker answers only the exact
      // public routes there (POST /v1/devices, GET /v1/health); everything else needs Access.
      "routes": [
        { "pattern": "desk.fromthedumpsterfire.com", "custom_domain": true },
        { "pattern": "api.fromthedumpsterfire.com", "custom_domain": true }
      ],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
