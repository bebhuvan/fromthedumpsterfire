{
  "$comment": "Task -> model chain. The router tries each model in order, skipping any whose provider key is not set, and falls back on errors. Workers AI models need no key and are the working fallback. Prices are USD per million tokens and are used for the spend ledger; check them against the provider's price page when you change a model. Override at deploy time with the MODEL_ROUTES var (same shape; tasks and models are merged over these).",
  "byok": false,
  "tasks": {
    "read": { "chain": ["gemini-flash", "deepseek-chat", "wai-deepseek-flash", "wai-scout"], "maxTokens": 4000, "temperature": 0.2, "maxInputChars": 120000 },
    "draft": { "chain": ["gemini-pro", "deepseek-chat", "wai-kimi", "wai-deepseek-flash"], "maxTokens": 8000, "temperature": 0.5, "maxInputChars": 90000 },
    "judge": { "chain": ["gemini-pro", "deepseek-chat", "wai-kimi", "wai-deepseek-flash"], "maxTokens": 3000, "temperature": 0, "maxInputChars": 60000 },
    "clean": { "chain": ["gemini-flash", "deepseek-chat", "wai-deepseek-flash", "wai-scout"], "maxTokens": 6000, "temperature": 0, "maxInputChars": 30000 },
    "ocr": { "chain": ["gemini-flash", "wai-scout"], "maxTokens": 6000, "temperature": 0, "maxInputChars": 2000, "vision": true },
    "haul": { "chain": ["gemini-pro", "deepseek-chat", "wai-kimi", "wai-deepseek-flash"], "maxTokens": 3000, "temperature": 0.5, "maxInputChars": 60000 }
  },
  "models": {
    "gemini-flash": { "provider": "google-ai-studio", "model": "gemini-2.5-flash", "inUsdPerM": 0.3, "outUsdPerM": 2.5, "json": "schema", "vision": true },
    "gemini-pro": { "provider": "google-ai-studio", "model": "gemini-2.5-pro", "inUsdPerM": 1.25, "outUsdPerM": 10, "json": "schema", "vision": true },
    "deepseek-chat": { "provider": "deepseek", "model": "deepseek-chat", "inUsdPerM": 0.28, "outUsdPerM": 0.42, "json": "object" },
    "claude-sonnet": { "provider": "anthropic", "model": "claude-sonnet-4-5", "inUsdPerM": 3, "outUsdPerM": 15, "json": "prompt" },
    "wai-deepseek-flash": { "provider": "workers-ai", "model": "@cf/deepseek-ai/deepseek-v4-flash-0731", "inUsdPerM": 0.3, "outUsdPerM": 1.2, "json": "schema", "thinking": false },
    "wai-kimi": { "provider": "workers-ai", "model": "@cf/moonshotai/kimi-k2.6", "inUsdPerM": 0.6, "outUsdPerM": 2.5, "json": "schema", "thinking": false },
    "wai-scout": { "provider": "workers-ai", "model": "@cf/meta/llama-4-scout-17b-16e-instruct", "inUsdPerM": 0.27, "outUsdPerM": 0.85, "json": "schema", "vision": true },
    "wai-llama-70b": { "provider": "workers-ai", "model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast", "inUsdPerM": 0.29, "outUsdPerM": 2.25, "json": "schema" }
  },
  "transcribe": { "model": "@cf/openai/whisper-large-v3-turbo", "usdPerAudioMinute": 0.00051 }
}
