# Static files served without the Worker (see run_worker_first in wrangler.jsonc). Pages get their
# headers from the Worker (src/worker/lib.ts).
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
