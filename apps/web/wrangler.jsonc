{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The public website: a static Astro build (dist/) served from Workers static assets. The tiny
  // Worker in src/worker runs first to redirect www to the apex, map the app's deep-link aliases
  // and add security headers. No bindings beyond ASSETS; every deploy must name an environment.
  "name": "fdf-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  "env": {
    "preview": {
      "name": "fdf-web-preview",
      "vars": { "ENVIRONMENT": "preview" },
      "workers_dev": true,
      "preview_urls": false
    },
    "production": {
      "name": "fdf-web",
      "vars": { "ENVIRONMENT": "production" },
      "routes": [
        { "pattern": "fromthedumpsterfire.com", "custom_domain": true },
        { "pattern": "www.fromthedumpsterfire.com", "custom_domain": true }
      ],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
