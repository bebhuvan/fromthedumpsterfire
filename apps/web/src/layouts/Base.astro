---
// The page frame (design: Salvage, docs/DESIGN.md). A small struck masthead in every header, an
// optional running head under it, and an optional folio above the footer: the flame, then where the page sits.
import '../styles/global.css';
import { palettes } from '@fdf/shared/tokens';
import { LICENCE } from '@fdf/shared/about';
import { absolute, EDITOR_NAME, paths, SITE_DESCRIPTION, SITE_NAME, SOURCE_URL } from '../lib/site';
import { markdownMirrorFor } from '../worker/lib';
import Masthead from '../components/Masthead.astro';
import Fingerprint from '../components/Fingerprint.astro';
import type { Edition } from '@fdf/shared/tokens';
import type { Haul } from '@fdf/shared/haul';

interface Props {
  /** Page title without the site name; omit on the home page. */
  title?: string;
  description?: string;
  /** Canonical path, e.g. "/haul/1". Defaults to the current path. */
  path?: string;
  type?: 'website' | 'article';
  image?: { url: string; width: number; height: number; alt: string };
  /** Which top-level section is current, for aria-current in the nav. */
  section?: 'latest' | 'threads' | 'archive' | 'shelf' | 'search' | 'about';
  noindex?: boolean;
  /** Running head under the header: left links back to the Haul, right names the form. */
  runhead?: { href: string; left: string; right?: string };
  /** Folio at the foot of the page (an item's number in its Haul). */
  folio?: { left: string; number: string | number; of?: number };
  /** Drop the small masthead from the header when the page carries the big one. */
  bigMast?: boolean;
  /** Optional article metadata for OpenGraph, meta tags, and Schema.org. */
  publishedAt?: string;
  modifiedAt?: string;
  author?: string;
  articleSection?: string;
  tags?: string[];
  /** The Haul's edition ink: a band on the top edge and the Haul's marks in its colour. */
  edition?: Edition;
  /** In the running head, the Haul's mini fingerprint with this item drawn tall. */
  fingerprint?: { haul: Haul; current?: string };
  /** Optional path to the Markdown mirror of this page (e.g. "/haul/1.md" or "/llms.txt"). */
  markdownPath?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  path = Astro.url.pathname,
  type = 'website',
  image,
  section,
  noindex,
  runhead,
  folio,
  bigMast,
  publishedAt,
  modifiedAt,
  author,
  articleSection,
  tags,
  markdownPath = markdownMirrorFor(path) ?? undefined,
  edition,
  fingerprint,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const socialTitle = title ?? SITE_NAME;
const canonical = absolute(path);
const ogImageUrl = image ? image.url : absolute('/og.png');
const ogImageAlt = image ? image.alt : `${SITE_NAME}: the ember flame and the masthead`;
const nav = [
  { key: 'latest', href: paths.home, label: 'Latest' },
  { key: 'threads', href: paths.threads, label: 'Threads' },
  { key: 'archive', href: paths.archive, label: 'Archive' },
  { key: 'shelf', href: paths.shelf, label: 'Shelf' },
  { key: 'search', href: paths.search, label: 'Search' },
  { key: 'about', href: paths.about, label: 'About' },
] as const;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author ? `${EDITOR_NAME}; ${author}` : EDITOR_NAME} />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="theme-color" content={palettes.light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={palettes.dark.bg} media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={image ? String(image.width) : '1200'} />
    <meta property="og:image:height" content={image ? String(image.height) : '630'} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {type === 'article' && publishedAt ? <meta property="article:published_time" content={publishedAt.slice(0, 10)} /> : null}
    {type === 'article' && modifiedAt ? <meta property="article:modified_time" content={modifiedAt.slice(0, 10)} /> : null}
    {type === 'article' ? <meta property="article:author" content={EDITOR_NAME} /> : null}
    {type === 'article' && author && author !== EDITOR_NAME ? <meta property="article:author" content={author} /> : null}
    {type === 'article' && articleSection ? <meta property="article:section" content={articleSection} /> : null}
    {type === 'article' && tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={absolute(paths.feed)} />
    {markdownPath ? <link rel="alternate" type="text/markdown" title={`${socialTitle} (Markdown)`} href={absolute(markdownPath)} /> : null}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/NewsreaderText-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NewsreaderDisplay-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/tokens.css" />
    <script is:inline src="/theme-init.js"></script>
    <slot name="head" />
  </head>
  <body class:list={edition ? ['has-ed', `e-${edition}`] : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap top">
      {bigMast ? null : (
        <a class="top-home" href={paths.home} aria-label={`${SITE_NAME}, latest Haul`}>
          <span class="flame" aria-hidden="true"></span>
          <Masthead class="mast-s" />
        </a>
      )}
      <nav class="top-nav" aria-label="Sections">
        {nav.map((n) => <a href={n.href} class={`nav-${n.key}`} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <button class="tog" type="button" hidden aria-label="Switch to dark theme" data-theme-toggle><span aria-hidden="true"></span></button>
    </header>
    {runhead ? (
      <div class="wrap">
        <p class="runhead" itemscope itemtype="https://schema.org/BreadcrumbList">
          <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a itemprop="item" href={runhead.href}><span itemprop="name">{runhead.left}</span></a>
            <meta itemprop="position" content="1" />
          </span>
          {fingerprint ? <Fingerprint haul={fingerprint.haul} variant="mini" current={fingerprint.current} /> : null}
          {runhead.right ? (
            <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <link itemprop="item" href={canonical} />
              <span itemprop="name">{runhead.right}</span>
              <meta itemprop="position" content="2" />
            </span>
          ) : null}
        </p>
      </div>
    ) : null}
    <slot name="edge" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {folio ? <p class="wrap folio"><span class="folio-in"><span class="flame" aria-hidden="true"></span><span>{folio.left} · {folio.number}{folio.of ? ` of ${folio.of}` : ''}</span></span></p> : null}
    <footer class="wrap g foot" itemscope itemtype="https://schema.org/Periodical">
      <meta itemprop="name" content={SITE_NAME} />
      <meta itemprop="description" content={SITE_DESCRIPTION} />
      <meta itemprop="inLanguage" content="en-IN" />
      <link itemprop="url" href={absolute(paths.home)} />
      <span itemprop="editor" itemscope itemtype="https://schema.org/Person" hidden>
        <meta itemprop="name" content={EDITOR_NAME} />
      </span>
      <p class="m foot-mark"><span class="flame" aria-hidden="true"></span><Masthead /></p>
      <p class="c foot-line">Irregular hauls of things worth salvaging from the internet and the archive. The serif is the editor; <span class="machine">the blue sans is the machine.</span></p>
      <nav class="c foot-nav" aria-label="More">
        <a href={paths.archive}>Every Haul</a>
        <a href={paths.threads}>Threads</a>
        <a href={paths.shelf}>The shelf</a>
        <a href={paths.about}>How it's made</a>
        <a href={paths.feed}>RSS</a>
        <a href={paths.privacy}>Privacy</a>
        <a href={SOURCE_URL} rel="noopener noreferrer">The code</a>
      </nav>
      <p class="c foot-app">A mobile app is coming soon.</p>
      <p class="c foot-licence">{LICENCE.before}<a rel="license" itemprop="license" href={LICENCE.url}>{LICENCE.name}</a>{LICENCE.after}</p>
    </footer>
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
