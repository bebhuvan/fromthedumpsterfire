---
import ItemPage from '../../../components/ItemPage.astro';
import Unavailable from '../../../components/Unavailable.astro';
import { archive } from '../../../lib/runtime';
import { findHaul } from '../../../lib/site';

const found = findHaul(await archive(), Astro.params.n);
if (found.kind === 'missing') return new Response(null, { status: 404 });
const item = found.kind === 'ok' ? found.haul.items.find((i) => i.id === Astro.params.item) : undefined;
if (found.kind === 'ok' && !item) return new Response(null, { status: 404 });
if (found.kind === 'failed') Astro.response.status = 503;
---
{found.kind === 'ok' && item ? <ItemPage haul={found.haul} item={item} /> : <Unavailable what={`Haul ${Astro.params.n}`} />}
