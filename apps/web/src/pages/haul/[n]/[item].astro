---
// A glossed item: standard, Rhymes and poem layouts. Mirrors apps/mobile/src/screens/ItemScreen.tsx.
// One column on phones; on wide screens the editor's note sits left, the source in the middle and
// the machine's layer (marginalia, Wikipedia, connections) on the right.
import type { GetStaticPaths } from 'astro';
import type { Haul, Item } from '@fdf/shared/haul';
import { typeLabel } from '@fdf/shared/tokens';
import Base from '../../../layouts/Base.astro';
import Title from '../../../components/Title.astro';
import Chip from '../../../components/Chip.astro';
import Highlighted from '../../../components/Highlighted.astro';
import Voice from '../../../components/Voice.astro';
import Arrow from '../../../components/Arrow.astro';
import { archive } from '../../../lib/data';
import { joinMeta, minutes, paths, safeHref, titleText } from '../../../lib/site';

export const getStaticPaths = (async () => {
  // Path segments the app reserves under /haul/<n>/ (see apps/mobile/src/nav.ts).
  const RESERVED = new Set(['note', 'thread']);
  const { hauls } = await archive();
  return hauls.flatMap((haul) =>
    haul.items.map((item) => {
      if (RESERVED.has(item.id)) throw new Error(`Haul ${haul.number}: item id "${item.id}" collides with the /haul/<n>/${item.id} route`);
      return { params: { n: String(haul.number), item: item.id }, props: { haul, item } };
    }),
  );
}) satisfies GetStaticPaths;

const { haul, item } = Astro.props as { haul: Haul; item: Item };
const at = haul.items.indexOf(item);
const next: Item | undefined = haul.items[at + 1];
const rhymes = item.type === 'rhymes' && !!item.rhyme;
const poem = item.type === 'poem' && !!item.excerpt;
const source = safeHref(item.media?.url ?? item.source.url);
const sourceLabel = item.media ? item.media.label : item.type === 'rabbit-hole' ? 'Go down the hole' : `Read the original${item.source.name && item.source.name !== titleText(item.title) ? ` at ${item.source.name}` : ''}`;
const hasLead = !!item.plate || rhymes || poem;
const plateSrc = item.plate ? safeHref(item.plate.url) : undefined;
const description = item.why.text.length > 200 ? item.why.text.slice(0, item.why.text.lastIndexOf(' ', 197)) + '…' : item.why.text;
const targetType = (id?: string) => (id ? haul.items.find((x) => x.id === id)?.type : undefined);
---
<Base
  title={`${titleText(item.title)}, ${item.creator}`}
  description={description}
  path={paths.item(haul.number, item.id)}
  type="article"
  image={item.plate && plateSrc ? { url: plateSrc, width: item.plate.width, height: item.plate.height, alt: item.plate.caption || titleText(item.title) } : undefined}
>
  <header class:list={['item-head', `t-${item.type}`, { 'plain-head': rhymes }]}>
    <div class="wrap item-head-inner">
      <div class="topbar">
        <a class="back label" href={paths.haul(haul.number)}><Arrow back />Haul {haul.number}</a>
        <span class="meta" aria-label={`Item ${at + 1} of ${haul.items.length}`}>{at + 1} of {haul.items.length}</span>
      </div>
      {rhymes ? <Chip type="rhymes" /> : <p class="label">{joinMeta(typeLabel[item.type], item.source.name, item.source.date, minutes(item.minutes))}</p>}
      <Title title={item.title} as="h1" class="title-l" />
      {!rhymes ? <p class="creator">{item.creator}</p> : null}
    </div>
  </header>

  <div class:list={['wrap', 'item-body', `t-${item.type}`, { 'wide-lead': rhymes, 'no-lead': !hasLead }]}>
    {hasLead ? (
      <div class="a-lead">
        {item.plate && plateSrc ? (
          <figure class="plate">
            <img src={plateSrc} width={item.plate.width} height={item.plate.height} alt={item.plate.caption || `Plate for ${titleText(item.title)}`} loading="lazy" decoding="async" />
            <figcaption>{item.plate.caption} {item.plate.credit}, {item.plate.licence}.</figcaption>
          </figure>
        ) : null}

        {rhymes && item.rhyme ? (
          <div class="rhyme">
            <figure class="era s-sky">
              <p class="era-year">{item.rhyme.then.year}</p>
              <blockquote class="era-quote">“{item.rhyme.then.quote}”</blockquote>
              <figcaption class="era-cite">{item.rhyme.then.cite}</figcaption>
            </figure>
            <div class="bridge">
              <p class="machine"><span class="sr">The machine's bridge: </span>{item.rhyme.bridge}</p>
            </div>
            <figure class="era era-now">
              <p class="era-year">{item.rhyme.now.year}</p>
              <blockquote class="era-quote">“{item.rhyme.now.quote}”</blockquote>
              <figcaption class="era-cite">{item.rhyme.now.cite}</figcaption>
            </figure>
          </div>
        ) : null}

        {poem && item.excerpt ? (
          <figure class="poem-block">
            <blockquote class="poem-text">{item.excerpt.text}</blockquote>
            <figcaption class="meta">{item.creator}, {item.source.name}</figcaption>
          </figure>
        ) : null}
      </div>
    ) : null}

    <section class="a-why" aria-labelledby="why-title">
      <div class="why-head">
        <h2 class="h-section" id="why-title">{rhymes ? 'My two bits' : "Why it's here"}</h2>
      </div>
      <p class="note note-block">{item.why.text}</p>
      <p class="sign" aria-label="Bhuvanesh, the editor">B.</p>
      {item.why.audio ? <Voice audio={item.why.audio} label="This note, in my voice" /> : null}
    </section>

    {item.excerpt && !poem ? (
      <figure class="a-excerpt">
        <div class="quote-mark" aria-hidden="true">“</div>
        <blockquote cite={safeHref(item.source.url)}>
          <Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} class="excerpt" />
        </blockquote>
        <figcaption class="meta excerpt-meta">{joinMeta(item.excerpt.locator || undefined, 'matched word for word against the source')}</figcaption>
      </figure>
    ) : null}

    <div class="a-act item-actions">
      {source ? (
        <a class="pill wide" href={source} rel="noopener noreferrer" target="_blank">{sourceLabel}<span class="ext" aria-hidden="true">↗</span><span class="sr"> (opens in a new tab)</span></a>
      ) : null}
    </div>

    {item.connections.length ? (
      <section class="a-edges" aria-labelledby="edges-title">
        <h2 class="h-section" id="edges-title">Where it connects</h2>
        <ul class="edges">
          {item.connections.map((c) => {
            const t = targetType(c.itemId);
            const href = c.itemId ? paths.item(haul.number, c.itemId) : c.threadId ? paths.thread(haul.number, c.threadId) : undefined;
            return (
              <li>
                <a class:list={['edge', t ? `t-${t}` : null]} href={href}>
                  <span class="label">{c.type}</span>
                  <span class="edge-title">{c.title}</span>
                  <span class="edge-note">{c.note}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ) : null}

    {item.marginalia.length || item.wiki.length ? (
      <div class="a-side">
        {item.marginalia.length ? (
          <section class="marginalia" aria-labelledby="margin-title">
            <div class="marginalia-head">
              <h2 class="machine-label" id="margin-title">Marginalia</h2>
              <span class="meta">Machine-read, editor-checked</span>
            </div>
            <ul>
              {item.marginalia.map((m) => (
                <li>
                  <p class="machine">{m.text}</p>
                  <span class="cite">Source: {m.cite}</span>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        {item.wiki.length ? (
          <section aria-labelledby="wiki-title">
            <h2 class="h-section" id="wiki-title">Further, via Wikipedia</h2>
            <ul class="wiki">
              {item.wiki.map((w) => {
                const href = safeHref(w.url);
                return (
                  <li>
                    {href ? (
                      <a href={href} rel="noopener noreferrer" target="_blank">
                        <span class="wiki-title"><span>{w.title}</span><span class="ext" aria-hidden="true">↗</span></span>
                        <span class="wiki-sum">{w.summary}</span>
                      </a>
                    ) : (
                      <div class="plain-wiki"><span class="wiki-title"><span>{w.title}</span></span><span class="wiki-sum">{w.summary}</span></div>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        ) : null}

      </div>
    ) : null}
  </div>

  <div class="wrap">
    <div class="read-next">
      {next ? (
        <a class:list={['next', `t-${next.type}`]} href={paths.item(haul.number, next.id)}>
          <span class="label">Next · {typeLabel[next.type]}</span>
          <Title title={next.title} as="span" class="title-s" />
          <span class="card-by">{next.creator}</span>
        </a>
      ) : (
        <div class="next next-end">
          <p class="label">End of Haul {haul.number}</p>
          <p>{haul.colophon}</p>
          <p><a href={paths.haul(haul.number)}>Back to the cover</a></p>
        </div>
      )}
    </div>
  </div>
</Base>
