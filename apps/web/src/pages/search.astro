---
// Search every Haul. Results are scored in the browser over /search.json; the A to Z index below
// works without JavaScript.
import Base from '../layouts/Base.astro';
import { archive } from '../lib/runtime';
import { topicIndex } from '../lib/search';
import { paths, titleText } from '../lib/site';

const { hauls } = await archive();
const topics = topicIndex(hauls);
---
<Base title="Search" description="Search every Haul: people, places, years and ideas." path={paths.search} section="search">
  <section class="wrap g page-head">
    <h1 class="m mh">Search</h1>
    <div class="c">
      <form class="search-form" action={paths.search} method="get" role="search" data-search-form>
        <label class="sr" for="q">Search every Haul</label>
        <input class="search-input" id="q" name="q" type="search" placeholder="Search every Haul" autocomplete="off" spellcheck="false" enterkeyhint="search" />
      </form>
      <noscript><p class="deck">Search runs in your browser and needs JavaScript. The index of people, places and ideas below works without it.</p></noscript>
      <div class="filters" data-filters hidden></div>
      <p class="search-status" aria-live="polite" data-status></p>
      <ol class="results" data-results></ol>
    </div>
  </section>

  <div data-browse>
    <section class="wrap g row" aria-labelledby="index-title">
      <div class="m">
        <h2 class="mh" id="index-title">The index</h2>
        <p class="small ink2">People, places and ideas across every Haul, from the Wikipedia layer.</p>
        <p><button class="textbtn" type="button" data-surprise hidden>Open something at random</button></p>
      </div>
      <div class="c topics">
        {topics.map((t) => (
          <details>
            <summary><span>{t.title}</span><span class="ptr">{t.items.length}</span></summary>
            <ul>
              {t.items.map(({ n, item }) => <li><a href={paths.item(n, item.id)}>{titleText(item.title)}</a><span class="ink2 small"> · {item.creator} · Haul {n}</span></li>)}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </div>
  <script>
    import '../scripts/search';
  </script>
</Base>
