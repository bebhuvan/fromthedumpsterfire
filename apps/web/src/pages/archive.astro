---
// Every Haul, newest first: each row a back issue, its ghost number in the Haul's own colour.
import { haulSlug } from '@fdf/shared/haul';
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import { archive } from '../lib/runtime';
import { longDate, objects, paths, titleText } from '../lib/site';

const { hauls } = await archive();
---
<Base title="Every Haul" description="Every Haul so far, newest first." path={paths.archive} section="archive">
  <section class="wrap g page-head">
    <p class="m meta"><span>The archive</span><span>{objects(hauls.length).replace(/objects?/, hauls.length === 1 ? 'Haul' : 'Hauls')}</span></p>
    <div class="c">
      <Title title={{ text: 'Every', italic: 'Haul' }} as="h1" class="h-title" />
      <p class="deck">Newest first. Each Haul keeps its own colour, so the archive reads like a run of back issues.</p>
      <form class="find-in" action={paths.search} method="get" role="search">
        <label class="sr" for="aq">Search every Haul</label>
        <input class="search-input find-in-q" id="aq" name="q" type="search" placeholder="Look for a person, a year, an idea" autocomplete="off" spellcheck="false" enterkeyhint="search" />
        <button class="find-in-go" type="submit">Search</button>
      </form>
    </div>
  </section>
  <section class="wrap g contents" aria-label="Hauls">
    {hauls.length ? (
      <ol class="mc arch" reversed>
        {hauls.map((h) => (
          <li class={`s-${h.swatch}`}>
            <a href={paths.haul(h.number)} aria-label={`Haul ${h.number}: ${titleText(h.title)}`}>
              <span class="ar-num" aria-hidden="true">{haulSlug(h.number)}</span>
              <span class="ar-main">
                <span class="ar-date">{longDate(h.publishedAt)} · {objects(h.items.length).toLowerCase()}{h.version > 1 ? ` · corrected, version ${h.version}` : ''}</span>
                <span class="ar-title">{h.title.text}{h.title.italic ? ' ' : ''}{h.title.italic ? <em>{h.title.italic}</em> : null}</span>
                <span class="ar-deck">{h.deck}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="c">The first Haul is being gathered.</p>
    )}
  </section>
</Base>
