---
// The editor's note: their paragraphs as they wrote them, their links on their own words, signed "B."
// at the end of the last paragraph. A long note reads as prose; a short one is set larger (`lead`).
// Straight apostrophes and quotation marks are set curly for display; the stored words are untouched.
import { curlQuotes, noteParagraphs, type Item } from '@fdf/shared/haul';
import { safeHref } from '../lib/site';

interface Props {
  why: Item['why'];
  /** Set as the opening's standfirst when the note is short. */
  lead?: boolean;
  /** Sign with "B." (the transcript signs in its margin instead). */
  sign?: boolean;
}
const { why, lead = false, sign = true } = Astro.props;
const paras = noteParagraphs(why);
const words = why.text.split(/\s+/).length;
// Large italic suits a line or two; past that the note is read, so it takes the reading size.
const size = lead && words <= 45 ? 'note-lead' : words > 120 ? 'note-long' : 'note-short';
const last = paras.length - 1;
---
<div class:list={['ed-note', size]}>
  {paras.map((runs, i) => (
    <p>
      {runs.map((r) => {
        const href = r.url ? safeHref(r.url) : undefined;
        return href ? <a href={href} rel="noopener noreferrer" target="_blank">{curlQuotes(r.text)}<span class="sr"> (opens in a new tab)</span></a> : curlQuotes(r.text);
      })}
      {sign && i === last ? <> <span class="sign-in" aria-label="Bhuvanesh, the editor">B.</span></> : null}
    </p>
  ))}
</div>
