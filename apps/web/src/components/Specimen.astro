---
// One item on the cover, shown as a small specimen of its own printed form (lib/forms.ts): a cropped
// opening, a two-page spread, a transcript strip, an offprint, a broadside, a catalogue card or a
// book page. Under it, the number in ember, the type and the first sentence of the editor's note.
import { curlQuotes, haulSlug, notePlain, quoteLead, type Haul, type Item } from '@fdf/shared/haul';
import { typeLabel } from '@fdf/shared/tokens';
import Highlighted from './Highlighted.astro';
import { formOf, headword, quoteLength, speaker } from '../lib/forms';
import { renderChart } from '@fdf/shared/charts';
import { lifeYears } from '@fdf/shared/life';
import ChartSvg from './ChartSvg.astro';
import { firstSentence, paths, safeHref, titleText } from '../lib/site';

interface Props {
  haul: Haul;
  item: Item;
  /** Columns of twelve on the wide cover (coverSpans). */
  span?: number;
  /** Second in its row: set a little lower. */
  lower?: boolean;
}
const { haul, item, span, lower } = Astro.props;
const n = haul.items.indexOf(item) + 1;
const form = formOf(item);
const href = paths.item(haul.number, item.id);
const yearOf = (d: string) => /\b(1[0-9]{3}|20[0-9]{2})\b/.exec(d)?.[1] ?? d;
const len = titleText(item.title).length;
const hw = headword(item.title.text);
const ex = item.excerpt;
// The opening crop scales its title so long titles still fit the specimen.
// A card carries its plate like a print clipped to it.
const plate = item.plate ? safeHref(item.plate.url) : undefined;
const size = len > 40 ? 'sz-s' : len > 22 ? 'sz-m' : 'sz-l';
// A poem shows its first stanza (or its first eight lines), each line as the poet broke it.
const poemLines = form === 'broadside' && ex ? (ex.text.split(/\n\s*\n/)[0] ?? '').split('\n').slice(0, 8) : [];
const poemMore = form === 'broadside' && ex ? ex.text.trim().split('\n').filter((l) => l.trim()).length > poemLines.length : false;
// A long quotation shows its lead large and the rest, cut short, in the reading size.
const epiLen = form === 'epigraph' && ex ? quoteLength(ex.text) : 'short';
const epiLead = form === 'epigraph' && ex && epiLen !== 'short' ? quoteLead(ex.text, ex.highlight) : null;
// Under the speaker's name, the occasion, without the name said twice.
const dropName = (s: string) => s.replace(new RegExp(`^${item.creator.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')},\\s*`), '');
const occasion = dropName(ex?.locator || item.source.name || '');
// A figure's specimen is its own chart, drawn small: the phone figure, a picture of the real thing.
const figChart = form === 'figure' ? item.blocks?.find((b) => b.kind === 'chart') : undefined;
let figScene: ReturnType<typeof renderChart> | null = null;
try {
  figScene = figChart?.kind === 'chart' ? renderChart(figChart.chart, 'narrow') : null;
} catch {
  figScene = null;
}
---
<li class:list={['sp', `sp-${form}`, `t-${item.type}`, span ? `c-${span}` : null, { lo: lower }]}>
  <p class="sp-cap" aria-hidden="true">
    <span class="sp-n">{String(n).padStart(2, '0')}</span>
    <span>{typeLabel[item.type]}{!['opening', 'offprint', 'card', 'label', 'life', 'broadside'].includes(form) ? <> · <span class="sp-ct">{curlQuotes(titleText(item.title))}</span></> : null}</span>
  </p>
  <a class="sp-obj" href={href} aria-label={`${n}. ${typeLabel[item.type]}: ${curlQuotes(titleText(item.title))}, ${item.creator}`}>
    {form === 'opening' ? (
      <>
        <span class="sp-meta">{item.source.name} · {item.source.date}</span>
        <span class:list={['sp-et', size]}>{curlQuotes(item.title.text)}{item.title.italic ? ' ' : ''}{item.title.italic ? <em>{curlQuotes(item.title.italic)}</em> : null}</span>
        <span class="sp-by">{item.creator}</span>
        {ex ? <span class:list={['sp-ex', { 'sp-ex-cut': !ex.highlight }]}>{curlQuotes(ex.highlight ?? ex.text)}</span> : null}
      </>
    ) : null}

    {form === 'facing' && item.rhyme ? (
      <>
        <span class="sp-l"><span class="sp-y">{item.rhyme.then.year}</span><span class="sp-q">{firstSentence(item.rhyme.then.quote)}</span></span>
        <span class="sp-r"><span class="sp-y">{item.rhyme.now.year}</span><span class="sp-q">{firstSentence(item.rhyme.now.quote)}</span></span>
      </>
    ) : null}

    {form === 'transcript' ? (
      <>
        <span class="sp-who">{speaker(item.creator)}</span>
        {ex ? <Highlighted as="span" class="sp-said" text={ex.text} highlight={ex.highlight} /> : <span class="sp-said">{curlQuotes(titleText(item.title))}</span>}
        <span class="sp-when">{item.source.name}, {item.source.date}</span>
      </>
    ) : null}

    {form === 'offprint' ? (
      <>
        <span class="sp-rc">{item.source.name} · {yearOf(item.source.date)}</span>
        <span class="sp-ot">{curlQuotes(titleText(item.title))}</span>
        <span class="sp-ob">{item.creator}</span>
        {ex ? <><span class="sp-ab">{ex.locator || 'Abstract'}</span><Highlighted as="span" class="sp-at" text={ex.text} highlight={ex.highlight} /></> : null}
      </>
    ) : null}

    {form === 'broadside' && ex ? (
      <>
        <span class="sp-ptt"><span class="sp-pti">{curlQuotes(titleText(item.title))}</span><span class="sp-pf">{item.creator}</span></span>
        <span class="sp-pt">{poemLines.map((l) => <span class="sp-pl">{l}</span>)}</span>
        {poemMore ? <span class="sp-pmore">The whole poem</span> : null}
      </>
    ) : null}

    {form === 'card' ? (
      <>
        <span class="sp-call"><span>FDF {haulSlug(haul.number)}.{n}</span><span>{typeLabel[item.type]}</span></span>
        <span class="sp-hw">{hw.head}{hw.article ? <>, <i>{hw.article}</i></> : null}</span>
        <span class="sp-d">{item.source.date}</span>
        {ex ? <span class="sp-ce">{ex.text}</span> : null}
        {plate ? <img class="sp-cardprint" src={plate} width={item.plate!.width} height={item.plate!.height} alt="" loading="lazy" decoding="async" /> : null}
        <span class="sp-punch" aria-hidden="true"></span>
      </>
    ) : null}

    {form === 'page' ? (
      <>
        <span class="sp-bh"><span>{item.source.name}</span><span>{item.creator}</span></span>
        {ex ? <span class="sp-bt">{curlQuotes(ex.text)}</span> : <span class="sp-bt">{curlQuotes(titleText(item.title))}</span>}
        <span class="sp-bf">{curlQuotes(dropName(ex?.locator || item.source.date))}</span>
      </>
    ) : null}
    {form === 'epigraph' && ex ? (
      <>
        {epiLead ? (
          <span class="sp-eq q-lead"><span class="sp-eql">{curlQuotes(epiLead.lead)}</span><span class="sp-eqr">{curlQuotes(epiLead.rest.trim())}</span></span>
        ) : (
          <span class:list={['sp-eq', `q-${epiLen}`]}>{curlQuotes(ex.text)}</span>
        )}
        <span class="sp-ew"><span>{item.creator}</span>{occasion ? <span class="sp-ewo">{occasion}</span> : null}</span>
      </>
    ) : null}

    {form === 'letter' && ex ? (
      <>
        <span class="sp-ld">{item.place ? `${item.place}, ` : ''}{item.source.date}</span>
        <span class="sp-lt">{ex.text}</span>
        <span class="sp-ls">{item.creator}</span>
      </>
    ) : null}

    {form === 'clipping' && ex ? (
      <>
        <span class="sp-cf"><span>{item.creator}{item.handle ? ` ${item.handle}` : ''}</span><span>{item.source.name}</span></span>
        <span class="sp-ct2">{ex.text}</span>
      </>
    ) : null}

    {form === 'print' && plate ? (
      <span class="sp-mount"><img src={plate} width={item.plate!.width} height={item.plate!.height} alt="" loading="lazy" decoding="async" /></span>
    ) : null}

    {form === 'jacket' ? (
      <span class="sp-jk"><span class="sp-jt">{item.title.text}{item.title.italic ? ' ' : ''}{item.title.italic ? <em>{item.title.italic}</em> : null}</span><span class="sp-ja">{item.creator}</span></span>
    ) : null}

    {form === 'figure' ? (
      <>
        <span class="sp-fig-t">{item.title.text}{item.title.italic ? ' ' : ''}{item.title.italic ? <em>{item.title.italic}</em> : null}</span>
        {figScene ? (
          <svg class="ch sp-fig-svg" viewBox={`0 0 ${figScene.width} ${figScene.height}`} aria-hidden="true" focusable="false" preserveAspectRatio="xMinYMin meet"><ChartSvg nodes={figScene.nodes} /></svg>
        ) : null}
        <span class="sp-fig-src">{item.source.name}</span>
      </>
    ) : null}

    {form === 'life' && item.life ? (
      <>
        <span class="sp-lf-n">{item.life.name}</span>
        {lifeYears(item.life) ? <span class="sp-lf-y">{lifeYears(item.life)}</span> : null}
        <span class="sp-lf-e">{item.life.epithet.text}</span>
      </>
    ) : null}

    {form === 'label' ? (
      <>
        <span class="sp-lbt">{curlQuotes(titleText(item.title))}</span>
        {item.creator ? <span class="sp-lbr"><span>Made by</span><span>{item.creator}</span></span> : null}
        <span class="sp-lbr"><span>What it is</span><span>{item.source.name}</span></span>
        {ex ? <span class="sp-lbq">{curlQuotes(ex.text)}</span> : null}
      </>
    ) : null}
  </a>
  <p class="sp-why">{curlQuotes(firstSentence(notePlain(item.why)))}</p>
</li>
