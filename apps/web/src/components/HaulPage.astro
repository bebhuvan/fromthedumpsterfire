---
// One Haul's cover. The ghost number is the page's one loud thing; the field note sits in the reading
// column with the route in the margin; the contents are a fanned stack of sheets, one per item, each
// carrying the line the editor marked. Mirrors the app's Cover screen.
import { haulSlug, type Haul } from '@fdf/shared/haul';
import { typeLabel } from '@fdf/shared/tokens';
import Base from '../layouts/Base.astro';
import Title from './Title.astro';
import Highlighted from './Highlighted.astro';
import Voice from './Voice.astro';
import { marked } from '../lib/forms';
import { firstSentence, fullDate, longDate, objects, paths, titleText } from '../lib/site';

interface Props {
  haul: Haul;
  home?: boolean;
}
const { haul, home } = Astro.props;
const note = haul.fieldNote;
const typeOf = new Map(haul.items.map((i) => [i.id, i.type]));
const thread = haul.threads[0];
const year = (d: string) => /\b(1[0-9]{3}|20[0-9]{2})\b/.exec(d)?.[1] ?? '';
// The stack fans out a step per sheet, up to eight steps; longer Hauls repeat the fan.
const step = (i: number) => `step-${(i % 8) + 1}`;
---
<Base
  title={home ? undefined : `Haul ${haul.number}: ${titleText(haul.title)}`}
  description={haul.deck}
  path={home ? paths.home : paths.haul(haul.number)}
  type={home ? 'website' : 'article'}
  section={home ? 'latest' : undefined}
>
  <section class:list={['ghost', `s-${haul.swatch}`]} aria-labelledby="haul-title">
    <div class="wrap ghost-in">
      <span class="numeral" aria-hidden="true">{haulSlug(haul.number)}</span>
      <p class="gmeta">Haul {haulSlug(haul.number)} · <time datetime={haul.publishedAt.slice(0, 10)}>{fullDate(haul.publishedAt)}</time> · {objects(haul.items.length).toLowerCase()}</p>
      <h1 class="cover-title display" id="haul-title"><span class="sr">Haul {haul.number}: </span>{haul.title.text}{haul.title.italic ? ' ' : ''}{haul.title.italic ? <em>{haul.title.italic}</em> : null}</h1>
      <p class="cover-deck">{haul.deck}</p>
    </div>
  </section>

  <section class="wrap g fn" id="field-note" aria-labelledby="fn-title">
    {note.route.length ? (
      <div class="m fn-m">
        <h2 class="mh" id="route-title">The route</h2>
        <ol class="route" aria-labelledby="route-title">
          {note.route.map((step) => {
            const t = step.itemId ? typeOf.get(step.itemId) : undefined;
            const machine = step.by === 'machine';
            return (
              <li class:list={[{ 'by-machine': machine }, t ? `t-${t}` : null]}>
                <span class="day">{step.day}</span>
                <span class:list={['rt', { machine }]}>
                  {t ? <span class="key" aria-hidden="true"></span> : null}
                  {machine ? <span class="sr">The machine noticed: </span> : null}
                  {step.itemId ? <a href={paths.item(haul.number, step.itemId)}>{step.text}</a> : step.text}
                </span>
              </li>
            );
          })}
        </ol>
      </div>
    ) : null}
    <div class="c fn-c">
      <Title title={note.title} as="h2" class="h-sec" id="fn-title" />
      {note.audio ? <Voice audio={note.audio} label="Hear it as I said it" /> : null}
      {note.paragraphs.map((para) => <Highlighted text={para} highlight={note.highlight} />)}
      <p class="sign" aria-label="Bhuvanesh, the editor">B.</p>
    </div>
  </section>

  <section class="wrap g contents" aria-labelledby="contents-title">
    <h2 class="m mh" id="contents-title">In this Haul</h2>
    <ol class="stack">
      {haul.items.map((item, i) => {
        const line = marked(item);
        return (
          <li class:list={['band', `t-${item.type}`, step(i)]}>
            <a href={paths.item(haul.number, item.id)}>
              <span class="b-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="b-form">{typeLabel[item.type]}</span>
              <span class="b-main">
                <span class="b-title">{item.title.text}{item.title.italic ? ' ' : ''}{item.title.italic ? <em>{item.title.italic}</em> : null}</span>
                <span class="b-by">{item.creator}{year(item.source.date) ? `, ${year(item.source.date)}` : ''}</span>
                {line ? <span class="b-mk">{line}</span> : null}
                <span class="b-why">{firstSentence(item.why.text)}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  {thread ? (
    <section class="wrap g row" aria-labelledby="thread-title">
      <h2 class="m mh" id="thread-title">The thread</h2>
      <div class="c thread">
        <p class="th-t"><a href={paths.thread(haul.number, thread.id)}><Title title={thread.title} as="span" /></a></p>
        <ol class="years">
          {thread.points.map((pt) => <li class:list={{ in: pt.inHaul }}><span>{pt.year}</span>{pt.title}</li>)}
        </ol>
        <p class="machine small">{thread.provenance}</p>
      </div>
    </section>
  ) : null}

  <section class="wrap g row colo" aria-labelledby="colophon-title">
    <h2 class="m mh" id="colophon-title">Colophon</h2>
    <div class="c">
      <p>{haul.colophon}</p>
      {haul.corrections?.length ? (
        <div class="corrections">
          <h3 class="mh">Corrections</h3>
          <ul>
            {haul.corrections.map((c) => <li><time datetime={c.date.slice(0, 10)}>{longDate(c.date)}</time>: {c.text}</li>)}
          </ul>
          <p class="small ink2">This is version {haul.version} of Haul {haul.number}.</p>
        </div>
      ) : null}
    </div>
  </section>
</Base>
