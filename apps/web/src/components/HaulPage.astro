---
// One Haul's cover. The ghost number is the page's one loud thing; the field note sits in the reading
// column with the route in the margin; the contents show each item as a small specimen of its own
// printed form (Specimen.astro). Mirrors the app's Cover screen.
import { haulSlug, type Haul } from '@fdf/shared/haul';
import { editionOf } from '@fdf/shared/tokens';
import Base from '../layouts/Base.astro';
import Title from './Title.astro';
import Highlighted from './Highlighted.astro';
import Voice from './Voice.astro';
import Specimen from './Specimen.astro';
import Masthead from './Masthead.astro';
import Fingerprint from './Fingerprint.astro';
import {
  absolute,
  EDITOR_NAME,
  fullDate,
  haulCoverImage,
  haulLastmod,
  longDate,
  objects,
  paths,
  SITE_DESCRIPTION,
  SITE_NAME,
  safeHref,
  titleText,
} from '../lib/site';
import { coverSpans, formOf } from '../lib/forms';

interface Props {
  haul: Haul;
  home?: boolean;
}
const { haul, home } = Astro.props;
const note = haul.fieldNote;
const typeOf = new Map(haul.items.map((i) => [i.id, i.type]));
// The route cites the contents by number, the way a page cites a figure.
const numOf = new Map(haul.items.map((i, n) => [i.id, String(n + 1).padStart(2, '0')]));
const last = note.paragraphs.length - 1;
const slug = haulSlug(haul.number);
const issueTitle = `Haul ${haul.number}: ${titleText(haul.title)}`;
// The front page is the publication, so a link to it is previewed by the site's card; the Haul's own
// card belongs to /haul/<n>.
const coverImage = home ? undefined : haulCoverImage(haul);
const lastmod = haulLastmod(haul);
const coverPlate = haul.cover;
const coverSrc = coverPlate ? safeHref(coverPlate.url) : undefined;
const spans = coverSpans(haul.items.map(formOf));
// The second object in a row sits a little lower.
const lower = spans.map((_, i) => spans.slice(0, i).reduce((a, b) => a + b, 0) % 12 !== 0);
const tags = [...new Set(haul.items.flatMap((i) => i.wiki.map((w) => w.title)))];
---
<Base
  title={home ? `Haul ${slug}: ${titleText(haul.title)}` : issueTitle}
  description={home ? `${haul.deck} ${SITE_DESCRIPTION}` : haul.deck}
  path={home ? paths.home : paths.haul(haul.number)}
  type={home ? 'website' : 'article'}
  image={coverImage}
  section={home ? 'latest' : undefined}
  bigMast={home}
  publishedAt={haul.publishedAt}
  modifiedAt={lastmod}
  articleSection={`Haul ${slug}`}
  tags={tags}
  markdownPath={paths.haulMd(haul.number)}
  edition={editionOf(haul.number, haul.edition)}
>
  {home ? (
    <section class="wrap nameplate" aria-label="From the Dumpster Fire">
      <p class="np-name"><Masthead /></p>
      <p class="np-strap"><span>Irregular hauls of things worth salvaging from the internet and the archive</span><span>Chosen by one editor, read with machines</span></p>
    </section>
  ) : null}
  <section
    class:list={['cover', { 'with-plate': coverPlate }]}
    aria-labelledby="haul-title"
    itemscope
    itemtype="https://schema.org/PublicationIssue"
  >
    <meta itemprop="issueNumber" content={String(haul.number)} />
    <meta itemprop="datePublished" content={haul.publishedAt.slice(0, 10)} />
    <meta itemprop="dateModified" content={lastmod} />
    <link itemprop="url" href={absolute(paths.haul(haul.number))} />
    {coverImage ? <link itemprop="image" href={coverImage.url} /> : null}
    <span itemprop="author" itemscope itemtype="https://schema.org/Person" hidden>
      <meta itemprop="name" content={EDITOR_NAME} />
    </span>
    <span itemprop="isPartOf" itemscope itemtype="https://schema.org/Periodical" hidden>
      <meta itemprop="name" content={SITE_NAME} />
      <link itemprop="url" href={absolute(paths.home)} />
    </span>
    <div class="wrap g cv">
      <p class="m cv-no"><span class="cv-h">Haul</span><span class="cv-n" aria-hidden="true">{slug}</span><span><time datetime={haul.publishedAt.slice(0, 10)}>{fullDate(haul.publishedAt)}</time></span><span>{objects(haul.items.length)}</span></p>
      <div class="cv-c">
        <h1 class="cv-t display" id="haul-title" itemprop="name headline"><span class="sr">Haul {haul.number}: </span>{haul.title.text}{haul.title.italic ? ' ' : ''}{haul.title.italic ? <em>{haul.title.italic}</em> : null}</h1>
        <p class="cv-deck" itemprop="description">{haul.deck}</p>
      </div>
      {coverPlate && coverSrc ? (
        <figure class="cv-plate">
          <img src={coverSrc} width={coverPlate.width} height={coverPlate.height} alt={coverPlate.caption || ''} decoding="async" />
          <figcaption>{coverPlate.caption} {coverPlate.credit}.</figcaption>
        </figure>
      ) : null}
    </div>
    <div class="wrap"><Fingerprint haul={haul} /></div>
  </section>

  <section class="wrap g fn" id="field-note" aria-labelledby="fn-title">
    {note.route.length ? (
      <div class="m fn-m">
        <h2 class="mh" id="route-title">The route</h2>
        <ol class="route" aria-labelledby="route-title">
          {note.route.map((step) => {
            const t = step.itemId ? typeOf.get(step.itemId) : undefined;
            const machine = step.by === 'machine';
            return (
              <li class:list={[{ 'by-machine': machine }, t ? `t-${t}` : null]}>
                <span class="day">{step.day}</span>
                <span class:list={['rt', { machine }]}>
                  {machine ? <span class="sr">The machine noticed: </span> : null}
                  {step.itemId ? <a href={paths.item(haul.number, step.itemId)}>{step.text}<span class="xref" aria-label={`, item ${numOf.get(step.itemId)}`}>{numOf.get(step.itemId)}</span></a> : step.text}
                </span>
              </li>
            );
          })}
        </ol>
      </div>
    ) : null}
    <div class="c fn-c">
      <Title title={note.title} as="h2" class="h-sec" id="fn-title" />
      {note.audio ? <Voice audio={note.audio} label="Hear it as I said it" /> : null}
      {note.paragraphs.map((para, i) => (
        <Highlighted text={para} highlight={note.highlight} curl class={i === 0 ? 'fn-first' : undefined}>{i === last ? <> <span class="sign-in endmark" aria-label="Bhuvanesh, the editor">B.</span></> : null}</Highlighted>
      ))}
    </div>
  </section>

  <div class="wrap orn" aria-hidden="true"><span class="flame"></span></div>

  <section class="wrap g contents" aria-labelledby="contents-title">
    <h2 class="mh sp-h" id="contents-title">In this Haul <span>{objects(haul.items.length).toLowerCase()}, each set in its own printed form</span></h2>
    <ol class="sp-list">
      {haul.items.map((item, i) => <Specimen haul={haul} item={item} span={spans[i]} lower={lower[i]} />)}
    </ol>
  </section>

  {haul.threads.map((thread, ti) => (
    <section class="wrap g row" aria-labelledby={`thread-title-${ti}`}>
      <h2 class="m mh" id={`thread-title-${ti}`}>{haul.threads.length > 1 ? `Thread ${ti + 1}` : 'The thread'}</h2>
      <div class="c thread">
        <p class="th-t"><a href={paths.thread(haul.number, thread.id)}><Title title={thread.title} as="span" /></a></p>
        <ol class="years">
          {thread.points.map((pt) => <li class:list={{ in: pt.inHaul }}><span>{pt.year}</span>{pt.title}</li>)}
        </ol>
        <p class="machine small">{thread.provenance}</p>
      </div>
    </section>
  ))}

  <section class="wrap g row colo" aria-labelledby="colophon-title">
    <h2 class="m mh" id="colophon-title">Colophon</h2>
    <div class="c">
      <p>{haul.colophon}</p>
      {haul.corrections?.length ? (
        <div class="corrections">
          <h3 class="mh">Corrections</h3>
          <ul>
            {haul.corrections.map((c) => <li><time datetime={c.date.slice(0, 10)}>{longDate(c.date)}</time>: {c.text}</li>)}
          </ul>
          <p class="small ink2">This is version {haul.version} of Haul {haul.number}.</p>
        </div>
      ) : null}
    </div>
  </section>
</Base>
