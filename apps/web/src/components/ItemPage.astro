---
// One item, set in its printed form (lib/forms.ts): a magazine opening, an offprint, a transcript,
// a broadside, facing pages, a catalogue card or a page from the book. Every form shares the working
// margin (meta, the machine's notes, speakers, section numbers), the running head, the thumb tab and
// the folio. Mirrors apps/mobile/src/screens/ItemScreen.tsx.
import { curlQuotes, haulSlug, leadLines, notePlain, quoteLead, sourceAction, speechSetting, type Haul, type Item } from '@fdf/shared/haul';
import { editionOf, typeLabel } from '@fdf/shared/tokens';
import Base from '../layouts/Base.astro';
import Title from './Title.astro';
import Highlighted from './Highlighted.astro';
import Voice from './Voice.astro';
import Notes from './Notes.astro';
import Note from './Note.astro';
import Quote from './Quote.astro';
import Ideas from './Ideas.astro';
import Blocks from './Blocks.astro';
import Credit from './Credit.astro';
import StartHere from './StartHere.astro';
import SeeAlso from './SeeAlso.astro';
import Life from './Life.astro';
import { formName, formOf, headword, quoteLength, speaker } from '../lib/forms';
import {
  absolute,
  EDITOR_NAME,
  haulCoverImage,
  haulLastmod,
  firstSentence,
  minutesLong,
  paths,
  safeHref,
  titleText,
} from '../lib/site';

interface Props {
  haul: Haul;
  item: Item;
  allHauls?: Haul[];
}
const { haul, item, allHauls } = Astro.props;
const at = haul.items.indexOf(item);
const n = at + 1;
const next: Item | undefined = haul.items[at + 1];
const form = formOf(item);
const H = `Haul ${haulSlug(haul.number)}`;
const source = safeHref(item.media?.url ?? item.source.url);
// Name the person, never only link them (sourceAction in @fdf/shared/haul).
const sourceLabel = form === 'card' ? 'Go down the hole' : sourceAction(item);
// The slip to the original: where it lives, then the date and the length, from the bundle alone.
const hostOf = (url: string) => /^https?:\/\/([^/?#]+)/i.exec(url)?.[1]?.replace(/^www\./, '') ?? '';
// A date already in the label is not said twice; a minute's reading is not worth saying.
const origMeta = [sourceLabel.includes(item.source.date) ? '' : item.source.date, item.minutes && item.minutes > 1 ? minutesLong(item.minutes) : ''].filter(Boolean).join(' · ');
// The person's name never breaks at its hyphen; a long label is set a size down.
const who = item.creator.trim();
const origParts = who && who.length <= 22 && sourceLabel.includes(who) ? sourceLabel.split(who) : null;
// A short tail (" in 404 Media") stays on one line, so the break falls before "in", not after it.
const origTail = origParts ? origParts.slice(1).join(who) : '';
const plateSrc = item.plate ? safeHref(item.plate.url) : undefined;
const plainWhy = notePlain(item.why);
const description = plainWhy.length > 200 ? plainWhy.slice(0, plainWhy.lastIndexOf(' ', 197)) + '…' : plainWhy;
const longTitle = titleText(item.title).length > 34;
const hw = headword(item.title.text);
const matched = 'matched word for word against the source';
// A poem in its stanzas (a blank line between), each line as the poet broke it.
const stanzas = form === 'broadside' && item.excerpt ? item.excerpt.text.split(/\n\s*\n/).map((st) => st.split('\n').filter((l) => l.trim())).filter((st) => st.length) : [];
// Where it was printed, without the poet's name said twice.
const sourceNoName = item.source.name.startsWith(`${item.creator}, `) ? item.source.name.slice(item.creator.length + 2) : item.source.name;
// A long epigraph opens on its first clauses set large; the rest follows in the reading type.
const epiLen = item.excerpt ? quoteLength(item.excerpt.text) : 'short';
const epiLead = form === 'epigraph' && item.excerpt && epiLen !== 'short' ? quoteLead(item.excerpt.text, item.excerpt.highlight) : null;
// A lead of short parallel clauses goes one clause to a line, sized to fill the measure.
const epiLines = epiLead ? leadLines(epiLead.lead) : null;
const llSize = epiLines ? `ll-${Math.max(8, epiLines.longest)}` : undefined;
const lastmod = haulLastmod(haul);
// A chart-led item is previewed by its chart's share card (the chart whole, with its title and credit).
const chartCard = item.type === 'chart' ? item.blocks?.find((b) => b.kind === 'chart' && b.images?.share) : undefined;
const cardSrc = chartCard?.kind === 'chart' && chartCard.images?.share ? safeHref(chartCard.images.share.url) : undefined;
// Otherwise its own card (its number, title and maker), then its plate, then the Haul's card.
const itemCard = item.card ? safeHref(item.card.url) : undefined;
const ogImage =
  chartCard?.kind === 'chart' && chartCard.images?.share && cardSrc
    ? { url: cardSrc, width: chartCard.images.share.width, height: chartCard.images.share.height, alt: chartCard.chart.title }
    : item.card && itemCard
      ? { url: itemCard, width: item.card.width, height: item.card.height, alt: `${titleText(item.title)}, ${item.creator}, in From the Dumpster Fire` }
      : item.plate && plateSrc
      ? { url: plateSrc, width: item.plate.width, height: item.plate.height, alt: item.plate.caption || titleText(item.title) }
      : haulCoverImage(haul);
---
<Base
  title={`${titleText(item.title)}, ${item.creator}`}
  description={description}
  path={paths.item(haul.number, item.id)}
  type="article"
  image={ogImage}
  runhead={{ href: paths.haul(haul.number), left: `${H} · ${titleText(haul.title)}`, right: formName[form] }}
  folio={{ left: H, number: n, of: haul.items.length }}
  publishedAt={haul.publishedAt}
  modifiedAt={lastmod}
  author={item.creator}
  articleSection={typeLabel[item.type]}
  tags={item.wiki.map((w) => w.title)}
  markdownPath={paths.itemMd(haul.number, item.id)}
  edition={editionOf(haul.number, haul.edition)}
  fingerprint={{ haul, current: item.id }}
>
  <nav slot="edge" class="tabs" aria-label={`Item ${n} of ${haul.items.length}`}>
    <a class:list={['tab', 'here', `n${Math.min(n, 20)}`, `t-${item.type}`]} href={paths.haul(haul.number)} aria-label={`Item ${n} of ${haul.items.length}. Back to the contents`}>{n}</a>
  </nav>

  <article
    class:list={[`t-${item.type}`, `form-${form}`]}
    aria-labelledby="item-title"
    itemscope
    itemtype="https://schema.org/Article"
  >
    <meta itemprop="headline" content={`${titleText(item.title)} — ${item.creator}`} />
    <meta itemprop="description" content={description} />
    <meta itemprop="datePublished" content={haul.publishedAt.slice(0, 10)} />
    <meta itemprop="dateModified" content={lastmod} />
    <meta itemprop="articleSection" content={typeLabel[item.type]} />
    <link itemprop="mainEntityOfPage" href={absolute(paths.item(haul.number, item.id))} />
    {ogImage ? <link itemprop="image" href={ogImage.url} /> : null}
    <span itemprop="author" itemscope itemtype="https://schema.org/Person" hidden>
      <meta itemprop="name" content={EDITOR_NAME} />
    </span>
    <span itemprop="isPartOf" itemscope itemtype="https://schema.org/PublicationIssue" hidden>
      <meta itemprop="issueNumber" content={String(haul.number)} />
      <meta itemprop="name" content={`${H}: ${titleText(haul.title)}`} />
      <link itemprop="url" href={absolute(paths.haul(haul.number))} />
    </span>
    <span itemprop="about citation" itemscope itemtype="https://schema.org/CreativeWork" hidden>
      <meta itemprop="name" content={titleText(item.title)} />
      <meta itemprop="author" content={item.creator} />
      <meta itemprop="publisher" content={item.source.name} />
      <meta itemprop="datePublished" content={item.source.date} />
      {source ? <link itemprop="url" href={source} /> : null}
    </span>

    {form === 'opening' || form === 'page' || form === 'figure' ? (
      <header class:list={['wrap', 'g', 'open', { fig: form === 'figure' }]}>
        <p class="m meta"><span><span class="key" aria-hidden="true"></span>{typeLabel[item.type]}</span><span>{item.source.name}, {item.source.date}</span>{item.minutes ? <span>{minutesLong(item.minutes)}</span> : null}</p>
        <Title title={item.title} as="h1" class:list={['mc', form === 'page' ? 'h-item' : 'essay-t', { 'essay-t-long': longTitle }]} id="item-title" />
        <p class="c byline">{item.creator}</p>
      </header>
    ) : null}

    {form === 'offprint' ? (
      <>
        <div class="wrap"><p class="runcite"><span>{item.creator}. {titleText(item.title)}. {item.source.name}, {item.source.date}.</span><span>{H}, item {n}</span></p></div>
        <header class="wrap g off">
          <p class="m meta"><span><span class="key" aria-hidden="true"></span>{typeLabel[item.type]}</span>{item.minutes ? <span>{minutesLong(item.minutes)}</span> : null}</p>
          <div class="c off-c">
            <Title title={item.title} as="h1" class="off-t" id="item-title" />
            <p class="off-by">{item.creator}</p>
          </div>
        </header>
      </>
    ) : null}

    {form === 'transcript' || form === 'facing' ? (
      <header class="wrap g tr-head">
        <p class="m meta"><span><span class="key" aria-hidden="true"></span>{typeLabel[item.type]}</span>{form === 'facing' && item.rhyme ? <span>{item.rhyme.then.year} and {item.rhyme.now.year}</span> : null}{item.minutes ? <span>{minutesLong(item.minutes)}</span> : null}</p>
        <div class="c">
          <Title title={item.title} as="h1" class="h-item" id="item-title" />
          {form === 'transcript' ? <p class="byline">{item.creator}</p> : null}
          {form === 'facing' ? (
            <>
              <div class="rh-sf"><Note why={item.why} lead /></div>
              {item.why.audio ? <Voice audio={item.why.audio} label="This note, in my voice" /> : null}
            </>
          ) : null}
        </div>
      </header>
    ) : null}

    {form === 'life' && item.life ? <Life item={{ ...item, life: item.life }} n={n} haulLabel={H} /> : null}

    {item.startHere && ['opening', 'offprint', 'transcript', 'page'].includes(form) ? <StartHere start={item.startHere} /> : null}

    {form === 'broadside' && item.excerpt ? (
      <div class="wrap g bs-lay">
        <p class="m meta"><span><span class="key" aria-hidden="true"></span>{typeLabel[item.type]}</span>{item.source.date ? <span>{item.source.date}</span> : null}</p>
        <figure class="bs">
          <header class="bs-head">
            <h1 class="bs-t" id="item-title"><Title title={item.title} as="span" /></h1>
            <p class="bs-by">{item.creator}</p>
          </header>
          <blockquote class="bs-poem" cite={safeHref(item.source.url)}>
            {stanzas.map((st) => (
              <p class="bs-stanza">{st.map((line) => <span class="bs-line">{line}</span>)}</p>
            ))}
          </blockquote>
          <figcaption class="bs-foot"><span>{sourceNoName}</span>{item.source.date && !sourceNoName.includes(item.source.date) ? <span>{item.source.date}</span> : null}</figcaption>
        </figure>
      </div>
    ) : null}

    {form === 'card' ? (
      <div class="wrap card-lay">
        <div class="card">
          <p class="c-call"><span>FDF {haulSlug(haul.number)}.{n}</span><span>{typeLabel[item.type]}</span></p>
          <h1 class="c-head" id="item-title">{hw.head}{hw.article ? <>, <i class="hw-the">{hw.article}</i></> : null}</h1>
          <p class="c-dates">{item.source.date}</p>
          <div class="c-ed"><Note why={item.why} /></div>
          {item.why.audio ? <Voice audio={item.why.audio} label="This note, in my voice" /> : null}
          {item.excerpt ? (
            <blockquote class="c-ex"><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} /></blockquote>
          ) : null}
          <Notes notes={item.marginalia} wiki={item.wiki} />
          {source ? <p class="c-src">Source: <a href={source} rel="noopener noreferrer" target="_blank">{item.source.name}, {titleText(item.title)}<span class="sr"> (opens in a new tab)</span></a></p> : null}
          <span class="punch" aria-hidden="true"></span>
        </div>
        {item.plate && plateSrc ? (
          <figure class="plate">
            <img src={plateSrc} width={item.plate.width} height={item.plate.height} alt={item.plate.caption || `Plate for ${titleText(item.title)}`} loading="lazy" decoding="async" />
            <figcaption><Credit plate={item.plate} maker={item.type === 'image' ? item.creator : undefined} /></figcaption>
          </figure>
        ) : null}
      </div>
    ) : null}

    {form === 'epigraph' && item.excerpt ? (
      <header class="wrap g epi">
        <p class="m meta"><span><span class="key" aria-hidden="true"></span>{typeLabel[item.type]}</span><span>{item.source.date}</span></p>
        <figure class="epi-f">
          <h1 class="sr" id="item-title">{titleText(item.title)}, {item.creator}</h1>
          {epiLead ? (
            <blockquote class="epi-q q-lead" cite={safeHref(item.source.url)}>
              <p class:list={['epi-lead', llSize]}><span class="qt-mark" aria-hidden="true">&#8220;</span>{epiLines ? epiLines.lines.map((l) => <span class="ll">{curlQuotes(l)} </span>) : curlQuotes(epiLead.lead)}</p>
              <Highlighted text={epiLead.rest.trim()} highlight={item.excerpt.highlight !== epiLead.lead ? item.excerpt.highlight : undefined} class="epi-rest" breaks="line" curl />
            </blockquote>
          ) : (
            <blockquote class:list={['epi-q', `q-${epiLen}`]} cite={safeHref(item.source.url)}><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} breaks="line" curl /></blockquote>
          )}
          <figcaption class="epi-who"><span class="epi-name">{item.creator}</span><span>{[item.source.name, item.source.date].filter(Boolean).join(', ')}</span></figcaption>
        </figure>
      </header>
    ) : null}

    {form === 'letter' && item.excerpt ? (
      <div class="wrap g">
        <article class="mc letter" aria-labelledby="item-title">
          <p class="lt-date">{item.place ? <span>{item.place}</span> : null}<span>{item.source.date}</span></p>
          <h1 class="lt-to" id="item-title"><span class="sr">{titleText(item.title)}. </span>From {item.creator}{item.recipient ? <> to {item.recipient}</> : null}</h1>
          <blockquote class="lt-body" cite={safeHref(item.source.url)}><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} /></blockquote>
          <p class="lt-sign">{item.creator}</p>
          <p class="lt-held">{item.source.name}{item.excerpt.locator ? `, ${item.excerpt.locator}` : ''}</p>
        </article>
      </div>
    ) : null}

    {form === 'clipping' && item.excerpt ? (
      <div class="wrap g">
        <article class="mc clip" aria-labelledby="item-title">
          <h1 class="sr" id="item-title">{titleText(item.title)}, a post by {item.creator}</h1>
          <dl class="clip-head">
            <div><dt>From</dt><dd><span class="clip-name">{item.creator}</span>{item.handle ? <span class="clip-handle">{item.handle}</span> : null}</dd></div>
            <div><dt>On</dt><dd>{item.source.name}</dd></div>
            <div><dt>Date</dt><dd>{item.source.date}</dd></div>
          </dl>
          <blockquote class="clip-text" cite={safeHref(item.source.url)}><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} /></blockquote>
        </article>
      </div>
    ) : null}

    {form === 'print' && item.plate && plateSrc ? (
      <div class="wrap g prt">
        <figure class="mc prt-f">
          <div class="prt-mount"><img src={plateSrc} width={item.plate.width} height={item.plate.height} alt={item.plate.caption || titleText(item.title)} decoding="async" /></div>
          <figcaption class="prt-label">
            <h1 class="prt-t display" id="item-title"><Title title={item.title} as="span" /></h1>
            <span class="prt-by">{item.creator}{item.source.date ? `, ${item.source.date}` : ''}</span>
            <span class="prt-from"><i>{item.source.name}</i></span>
            <span class="prt-cr"><Credit plate={item.plate} noCaption noBy /></span>
          </figcaption>
        </figure>
      </div>
    ) : null}

    {form === 'jacket' ? (
      <header class="wrap g jk">
        <div class="m jk-book" aria-hidden="true">
          {item.plate && plateSrc ? (
            <img class="jk-cover" src={plateSrc} width={item.plate.width} height={item.plate.height} alt="" decoding="async" />
          ) : (
            <span class="jk-jacket"><span class="jk-jt"><Title title={item.title} as="span" /></span><span class="jk-ja">{item.creator}</span><span class="jk-jp">{item.source.name}</span></span>
          )}
        </div>
        <div class="c jk-c">
          <p class="meta jk-meta"><span><span class="key" aria-hidden="true"></span>{typeLabel[item.type]}</span><span>{item.source.name}, {item.source.date}</span></p>
          <Title title={item.title} as="h1" class="h-item jk-t" id="item-title" />
          <p class="byline">{item.creator}</p>
          {item.excerpt ? (
            <figure class="jk-line">
              <blockquote cite={safeHref(item.source.url)}><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} /></blockquote>
              {item.excerpt.locator ? <figcaption>{item.excerpt.locator}</figcaption> : null}
            </figure>
          ) : null}
          {item.shelf ? <p class="jk-shelf"><a href={paths.book(item.shelf)}>All the editor’s notes on this book, on the shelf</a></p> : null}
        </div>
      </header>
    ) : null}

    {form === 'label' ? (
      <div class="wrap g">
        <article class="mc lab" aria-labelledby="item-title">
          <p class="lab-k"><span><span class="key" aria-hidden="true"></span>{typeLabel[item.type]}</span><span>FDF {haulSlug(haul.number)}.{n}</span></p>
          <Title title={item.title} as="h1" class="lab-t" id="item-title" />
          <dl class="lab-dl">
            {item.creator ? <div><dt>Made by</dt><dd>{item.creator}</dd></div> : null}
            <div><dt>What it is</dt><dd>{item.source.name}</dd></div>
            {item.source.date ? <div><dt>Since</dt><dd>{item.source.date}</dd></div> : null}
            {item.excerpt ? <div class="lab-own"><dt>In its own words</dt><dd><blockquote cite={safeHref(item.source.url)}><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} /></blockquote></dd></div> : null}
            {source ? <div><dt>Where</dt><dd><a href={source} rel="noopener noreferrer" target="_blank">{new URL(source).hostname.replace(/^www\./, '')}<span class="sr"> (opens in a new tab)</span></a></dd></div> : null}
          </dl>
        </article>
      </div>
    ) : null}

    {form === 'facing' && item.rhyme ? (
      <div class="wrap">
        <div class="spread">
          <section class="leaf leaf-then" aria-label={`Then, ${item.rhyme.then.year}`}>
            <p class="leaf-y">{item.rhyme.then.year}</p>
            <blockquote><p class="leaf-q">{item.rhyme.then.quote}</p></blockquote>
            <p class="leaf-c">{item.rhyme.then.cite}</p>
            <p class="leaf-f" aria-hidden="true">then</p>
          </section>
          <div class="gutter"><p class="machine"><span class="sr">The machine's bridge: </span>{item.rhyme.bridge}</p></div>
          <section class="leaf leaf-now" aria-label={`Now, ${item.rhyme.now.year}`}>
            <p class="leaf-y">{item.rhyme.now.year}</p>
            <blockquote><p class="leaf-q">{item.rhyme.now.quote}</p></blockquote>
            <p class="leaf-c">{item.rhyme.now.cite}</p>
            <p class="leaf-f" aria-hidden="true">now</p>
          </section>
        </div>
      </div>
    ) : null}

    {['opening', 'broadside', 'page', 'epigraph', 'letter', 'clipping', 'print', 'jacket', 'label', 'figure'].includes(form) ? (
      <section class="wrap g why" aria-labelledby="why-title">
        <h2 class="m mh why-h" id="why-title">Why it's here</h2>
        <div class="c why-c">
          <Note why={item.why} lead={form === 'opening' || form === 'figure'} />
          {item.why.audio ? <Voice audio={item.why.audio} label="This note, in my voice" /> : null}
        </div>
        {item.marginalia.length ? <div class="m why-notes"><Notes notes={item.marginalia} wiki={item.wiki} /></div> : null}
      </section>
    ) : null}

    {form === 'opening' && item.excerpt ? (
      <section class="wrap g pull" aria-label={`From ${titleText(item.title)}`}>
        <p class="m mh pull-h">From the piece</p>
        <div class="c">
          {item.excerpt.highlight && item.excerpt.highlight.split(/\s+/).length <= 40 ? <Quote class="pull-out" text={item.excerpt.highlight} /> : null}
          <Quote extract text={item.excerpt.text} highlight={item.excerpt.highlight} cite={item.source.url} credit={[item.creator, item.source.name, item.excerpt.locator, matched]} />
        </div>
      </section>
    ) : null}

    {form === 'page' && item.excerpt ? (
      <div class="wrap g">
        <figure class="c bookpage">
          <p class="bp-head"><span>{item.source.name}</span><span>{item.creator}</span></p>
          <blockquote cite={safeHref(item.source.url)}><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} class="bp-text" /></blockquote>
          <figcaption class="bp-foot">{item.excerpt.locator || item.source.date}</figcaption>
        </figure>
      </div>
    ) : null}

    {form === 'offprint' ? (
      <>
        {[
          { h: "Why it's here", kind: 'why' },
          ...(item.excerpt ? [{ h: 'From the paper', kind: 'excerpt' }] : []),
          ...(item.marginalia.length ? [{ h: 'Notes', kind: 'notes' }] : []),
          ...(item.wiki.length ? [{ h: 'References', kind: 'refs' }] : []),
        ].map((s, i) => (
          <section class="wrap g sec" aria-labelledby={`sec-${i}`}>
            <p class="m sec-n" aria-hidden="true">{i + 1}</p>
            <div class="c">
              <h2 class="sec-h" id={`sec-${i}`}><span class="sr">{i + 1}. </span>{s.h}</h2>
              {s.kind === 'why' ? (
                <>
                  <Note why={item.why} />
                  {item.why.audio ? <Voice audio={item.why.audio} label="This note, in my voice" /> : null}
                </>
              ) : null}
              {s.kind === 'excerpt' && item.excerpt ? (
                <Quote extract text={item.excerpt.text} highlight={item.excerpt.highlight} cite={item.source.url} credit={[item.creator, item.source.name, item.excerpt.locator, matched]} />
              ) : null}
              {s.kind === 'notes' ? <Notes notes={item.marginalia} wiki={item.wiki} /> : null}
              {s.kind === 'refs' ? (
                <ol class="refs">
                  {item.wiki.map((w, j) => {
                    const href = safeHref(w.url);
                    return (
                      <li itemprop="mentions" itemscope itemtype="https://schema.org/Thing">
                        <span class="rn">[{j + 1}]</span>
                        <span>
                          {href ? (
                            <a href={href} itemprop="sameAs url" rel="noopener noreferrer" target="_blank">
                              <span itemprop="name">{w.title}</span>
                            </a>
                          ) : (
                            <span itemprop="name">{w.title}</span>
                          )}
                          . <span itemprop="description">{w.summary}</span> <span class="ink2 small">Wikipedia.</span>
                        </span>
                      </li>
                    );
                  })}
                </ol>
              ) : null}
            </div>
          </section>
        ))}
      </>
    ) : null}

    {form === 'transcript' ? (
      <section class="wrap transcript" aria-label="From the transcript">
        {item.excerpt ? (
          <div class="g tl tl-said">
            <p class="m who">{speaker(item.creator)}<span class="when">{[item.source.name, item.source.date].filter(Boolean).join(', ')}</span></p>
            {speechSetting(item.excerpt.text) === 'line' ? (
              <blockquote class="c said" cite={safeHref(item.source.url)}><Highlighted text={item.excerpt.text} highlight={item.excerpt.highlight} /></blockquote>
            ) : (
              <div class="c said-x"><Quote extract text={item.excerpt.text} highlight={item.excerpt.highlight} cite={item.source.url} credit={[item.creator, item.source.name, item.excerpt.locator, matched]} /></div>
            )}
          </div>
        ) : null}
        <div class="g tl">
          <p class="m who who-ed"><span aria-hidden="true">B.</span><span class="sr">The editor, Bhuvanesh</span></p>
          <div class="c">
            <Note why={item.why} sign={false} />
            {item.why.audio ? <Voice audio={item.why.audio} label="This note, in my voice" /> : null}
          </div>
        </div>
        <Notes notes={item.marginalia} wiki={item.wiki} rows />
      </section>
    ) : null}

    {form === 'facing' && item.marginalia.length ? (
      <div class="wrap g row"><p class="m mh">Notes</p><div class="c"><Notes notes={item.marginalia} wiki={item.wiki} /></div></div>
    ) : null}

    <Blocks blocks={item.blocks ?? []} source={item.source.name} />

    <Ideas ideas={item.ideas ?? []} />

    {item.plate && plateSrc && form !== 'card' && form !== 'print' && form !== 'jacket' && form !== 'life' ? (
      <div class="wrap g">
        <figure class="c plate">
          <img src={plateSrc} width={item.plate.width} height={item.plate.height} alt={item.plate.caption || `Plate for ${titleText(item.title)}`} loading="lazy" decoding="async" />
          <figcaption><Credit plate={item.plate} maker={item.type === 'image' ? item.creator : undefined} /></figcaption>
        </figure>
      </div>
    ) : null}

    {source && form !== 'card' ? (
      <div class="wrap g row">
        <p class="m mh">The original</p>
        <a class:list={['c', 'orig', `t-${item.type}`]} href={source} rel="noopener noreferrer" target="_blank">
          <span class="orig-b">
            <span class="orig-k"><span class="key" aria-hidden="true"></span>{hostOf(source)}</span>
            <span class:list={['orig-t', { 'orig-long': sourceLabel.length > 46 }]}>{origParts ? <>{origParts[0]}<em class="nw">{who}</em>{origTail.length <= 28 && origTail.startsWith(' ') ? <> <span class="nw">{origTail.slice(1)}</span></> : origTail}</> : sourceLabel}<span class="sr"> (opens in a new tab)</span></span>
          </span>
          <span class="orig-f">
            <span class="orig-tear" aria-hidden="true"></span>
            <span class="orig-d">{origMeta || 'Opens in a new tab'}</span>
            <span class="orig-ar" aria-hidden="true">↗</span>
          </span>
        </a>
      </div>
    ) : null}

    <div class="wrap"><SeeAlso haul={haul} item={item} allHauls={allHauls} noWiki={form === 'offprint'} /></div>
  </article>

  <nav class="wrap g row next" aria-label="Next in this Haul">
    <p class="m mh">{next ? 'Next' : `End of ${H}`}</p>
    {next ? (
      <a class:list={['c', 'next-a', `t-${next.type}`]} href={paths.item(haul.number, next.id)}>
        <span class="next-k"><span class="key" aria-hidden="true"></span>{at + 2} · {typeLabel[next.type]}</span>
        <Title title={next.title} as="span" class="next-t" />
        <span class="next-why">{curlQuotes(firstSentence(notePlain(next.why)))}</span>
      </a>
    ) : (
      <a class="c next-a" href={paths.haul(haul.number)}><span class="next-k">The contents</span><Title title={haul.title} as="span" class="next-t" /></a>
    )}
  </nav>
</Base>
