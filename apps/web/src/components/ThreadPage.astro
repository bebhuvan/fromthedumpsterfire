---
// A thread, set as a chronology: the year in the margin, the point in the column, the machine's
// name for each link in blue. Mirrors apps/mobile/src/screens/ThreadScreen.tsx.
import { haulSlug, type Haul, type Thread } from '@fdf/shared/haul';
import Base from '../layouts/Base.astro';
import Title from './Title.astro';
import { paths, titleText } from '../lib/site';

interface Props {
  haul: Haul;
  thread: Thread;
}
const { haul, thread } = Astro.props;
const first = Number.parseInt(thread.points[0]?.year ?? '', 10);
const last = Number.parseInt(thread.points[thread.points.length - 1]?.year ?? '', 10);
const span = Number.isFinite(first) && Number.isFinite(last) && last > first ? last - first : 0;
---
<Base
  title={`${titleText(thread.title)}, a thread`}
  description={thread.summary}
  path={paths.thread(haul.number, thread.id)}
  type="article"
  section="threads"
  runhead={{ href: paths.haul(haul.number), left: `Haul ${haulSlug(haul.number)} · ${titleText(haul.title)}`, right: 'Thread' }}
>
  <section class="wrap g page-head">
    <p class="m meta"><span>Thread</span><span>{thread.points.length} points</span>{span ? <span>{span} years</span> : null}</p>
    <div class="c">
      <Title title={thread.title} as="h1" class="h-title" />
      <p class="deck">{thread.summary}</p>
    </div>
  </section>

  <ol class="wrap chron">
    {thread.points.map((pt) => (
      <li class:list={['g', 'pt', { out: !pt.inHaul }]}>
        <p class="m pt-y">{pt.year}</p>
        <div class="c">
          <p class="pt-t">{pt.itemId ? <a href={paths.item(haul.number, pt.itemId)}>{pt.title}</a> : pt.title}<span class="sr">{pt.inHaul ? ' (in this Haul)' : ' (from the archive)'}</span></p>
          <p class="pt-g">{pt.gist}</p>
          <p class="pt-e machine">{pt.edge}</p>
        </div>
      </li>
    ))}
  </ol>

  <section class="wrap g row">
    <p class="m mh">How it was made</p>
    <div class="c">
      <p class="machine">{thread.provenance}</p>
      <p class="src"><a href={paths.note(haul.number)}>Back to the field note of Haul {haulSlug(haul.number)}</a></p>
    </div>
  </section>
</Base>
